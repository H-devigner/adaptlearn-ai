# Obligatoires pour Docker/production. Générer trois valeurs différentes : openssl rand -hex 32
SECRET_KEY=
AI_SERVICE_TOKEN=
POSTGRES_PASSWORD=
POSTGRES_USER=adaptlearn
POSTGRES_DB=adaptlearn
COOKIE_SECURE=false

# Chaque nouveau support est généré par un vrai LLM.
AI_MODE=llm
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=45

# Exemple Ollama local à la place :
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:1.5b

# Embeddings neuronaux locaux : téléchargement au premier usage.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=instance/models
RAG_INDEX_DIR=instance/rag
RAG_MIN_SCORE=0.35
