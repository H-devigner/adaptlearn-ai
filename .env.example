# Générer une valeur distincte pour chaque secret avec openssl rand -hex 32.
SECRET_KEY=
AI_SERVICE_TOKEN=
POSTGRES_PASSWORD=

POSTGRES_USER=adaptlearn
POSTGRES_DB=adaptlearn

# Passer à true derrière un proxy HTTPS.
COOKIE_SECURE=false

# local fonctionne sans clé. Pour llm, renseigner le modèle et la clé du fournisseur.
AI_MODE=local
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=45
